{
  "name": "@getconnie/connie-js",
  "version": "1.1.0",
  "description": "Connie's browser SDK. Open a SignPage as a modal inside your own web app.",
  "keywords": [
    "connie",
    "e-signature",
    "esignature",
    "signpage",
    "embed",
    "mitid"
  ],
  "homepage": "https://github.com/connie-app/connie-js#readme",
  "bugs": {
    "url": "https://github.com/connie-app/connie-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connie-app/connie-js.git"
  },
  "license": "MIT",
  "author": "Connie ApS <hello@getconnie.com> (https://getconnie.com)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./v1.js": "./dist/v1.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "size": "node scripts/check-size.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "example": "npm run build && node scripts/serve.mjs",
    "check:package": "attw --pack . --exclude-entrypoints ./v1.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm test && npm run size && npm run check:package"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
